{% extends 'base.html.twig' %}

{% block title %}Cards index{% endblock %}

{% block body %}
    <h1>Cards index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>ManaCost</th>
                <th>Attack</th>
                <th>Health</th>
                <th>ImagePath</th>
                <th>IsActive</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for card in cards %}
            <tr>
                <td>{{ card.id }}</td>
                <td>{{ card.name }}</td>
                <td>{{ card.description }}</td>
                <td>{{ card.manaCost }}</td>
                <td>{{ card.attack }}</td>
                <td>{{ card.health }}</td>
                <td>{{ card.imagePath }}</td>
                <td>{{ card.isActive ? 'Yes' : 'No' }}</td>
                <td>{{ card.createdAt ? card.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ card.updatedAt ? card.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_cards_show', {'id': card.id}) }}">show</a>
                    <a href="{{ path('app_cards_edit', {'id': card.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_cards_new') }}">Create new</a>
{% endblock %}
