{# templates/cards/_torch.html.twig — декоративный факел; side: 'left' | 'right' #}
<span class="torch torch--{{ side|default('left') }}" aria-hidden="true">
    <span class="torch-fire">
        <span class="flame-glow"></span>
        <span class="flame-outer"></span>
        <span class="flame-inner"></span>
        <span class="flame-core"></span>
        <span class="spark s1"></span>
        <span class="spark s2"></span>
        <span class="spark s3"></span>
    </span>
    <span class="torch-bracket"></span>
    <span class="torch-handle"></span>
    <span class="torch-head"></span>
</span>
