{# templates/cards/form.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/form.css') }}">
{% endblock %}

{% block body %}
    <div class="edit-container">
        <h1>{{ card.id ? '✏️ Редактировать карту' : '➕ Создать новую карту' }}</h1>

        {# Flash сообщения #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        <!-- Название -->
        <div class="form-group {% if form.name.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.name, '🏷️ Название', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Введите название карты'}}) }}
            {{ form_errors(form.name) }}
        </div>

        <!-- Описание -->
        <div class="form-group {% if form.description.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.description, '📝 Описание', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'placeholder': 'Введите описание карты', 'rows': 4}}) }}
            {{ form_errors(form.description) }}
        </div>

        <!-- Стоимость маны -->
        <div class="form-group {% if form.manaCost.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.manaCost, '💎 Стоимость маны', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.manaCost, {'attr': {'class': 'form-control', 'type': 'number', 'min': 0, 'max': 10}}) }}
            {{ form_errors(form.manaCost) }}
        </div>

        <!-- Тип карты -->
        <div class="form-group {% if form.cardType.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.cardType, '📋 Тип карты', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.cardType, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.cardType) }}
        </div>

        <!-- Раса -->
        <div class="form-group {% if form.race.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.race, '🧝 Раса', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.race, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.race) }}
        </div>

        <!-- Редкость -->
        <div class="form-group {% if form.rarity.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.rarity, '⭐ Редкость', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.rarity, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.rarity) }}
        </div>

        <!-- Характеристики -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group {% if form.attack.vars.errors|length > 0 %}has-error{% endif %}">
                {{ form_label(form.attack, '⚔️ Атака', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.attack, {'attr': {'class': 'form-control', 'type': 'number', 'min': 0}}) }}
                {{ form_errors(form.attack) }}
            </div>

            <div class="form-group {% if form.health.vars.errors|length > 0 %}has-error{% endif %}">
                {{ form_label(form.health, '❤️ Здоровье', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.health, {'attr': {'class': 'form-control', 'type': 'number', 'min': 0}}) }}
                {{ form_errors(form.health) }}
            </div>
        </div>

        <!-- Изображение -->
        <div class="form-group {% if form.imageFile.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.imageFile, '🖼️ Изображение', {'label_attr': {'class': 'form-label'}}) }}

            <div class="image-upload-wrapper">
                {{ form_widget(form.imageFile, {'attr': {'accept': 'image/*'}}) }}
                <span class="upload-label">📁 Выберите файл</span>
            </div>

            {% if card.imagePath %}
                <div class="image-preview-container">
                    <img src="{{ asset('uploads/cards/' ~ card.imagePath) }}" alt="{{ card.name }}">
                    <div class="image-info">
                        <span class="filename">{{ card.imagePath }}</span>
                        <br>Текущее изображение
                        <br><small style="color: #6a6a8a;">Чтобы заменить, выберите новый файл</small>
                    </div>
                </div>
            {% else %}
                <div style="font-size: 12px; color: #6a6a8a; margin-top: 5px;">
                    Поддерживаются: JPEG, PNG, WEBP, GIF (макс. 5 МБ)
                </div>
            {% endif %}

            {{ form_errors(form.imageFile) }}
        </div>

        <!-- Способности -->
        <div class="form-group">
            <label style="display: block; font-weight: bold; font-size: 14px; color: #a0a0b0; margin-bottom: 10px; letter-spacing: 0.5px;">
                ⚡ Способности
            </label>

            {% if allAbilities is defined and allAbilities is not empty %}
                <div class="abilities-container">
                    {% for ability in allAbilities %}
                        {% set abilityId = ability.id %}
                        {% set isChecked = currentAbilities[abilityId] is defined %}
                        {% set abilityValue = currentAbilities[abilityId] ?? null %}

                        <div class="ability-checkbox">
                            <input type="checkbox"
                                   name="abilities[{{ abilityId }}][enabled]"
                                   value="1"
                                   id="ability_{{ abilityId }}"
                                   {% if isChecked %}checked{% endif %}
                                   class="ability-input">

                            <label for="ability_{{ abilityId }}" class="ability-name">
                                {{ ability.name }}
                            </label>

                            <input type="number"
                                   name="abilities[{{ abilityId }}][value]"
                                   value="{{ abilityValue }}"
                                   class="ability-value-input"
                                   placeholder="Знач."
                                   min="0"
                                   {% if not isChecked %}disabled{% endif %}>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p style="color: #6a6a8a;">Нет доступных способностей</p>
            {% endif %}
        </div>

        <!-- Теги -->
        <div class="form-group {% if form.tags.vars.errors|length > 0 %}has-error{% endif %}">
            {{ form_label(form.tags, '🏷️ Теги', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.tags, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.tags) }}
        </div>

        <!-- Активность -->
        <div class="form-group" style="margin-top: 15px;">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                {{ form_widget(form.isActive, {'attr': {'style': 'width: 20px; height: 20px; accent-color: #4a90d9;'}}) }}
                <span style="color: #f0f0f0; font-weight: bold;">✅ Карта активна</span>
            </label>
            {{ form_errors(form.isActive) }}
        </div>

        <!-- Действия -->
        <div class="form-actions">
            {% block form_actions %}{% endblock %}
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Включение/отключение поля значения способности
            const abilityCheckboxes = document.querySelectorAll('.ability-input');

            abilityCheckboxes.forEach(checkbox => {
                const container = checkbox.closest('.ability-checkbox');
                const valueInput = container.querySelector('.ability-value-input');

                if (valueInput) {
                    valueInput.disabled = !checkbox.checked;

                    checkbox.addEventListener('change', function() {
                        valueInput.disabled = !this.checked;
                        if (!this.checked) {
                            valueInput.value = '';
                        } else {
                            valueInput.focus();
                        }
                    });
                }
            });

            // Предпросмотр имени файла
            const fileInput = document.querySelector('input[type="file"]');
            if (fileInput) {
                fileInput.addEventListener('change', function() {
                    const label = this.parentElement.querySelector('.upload-label');
                    if (this.files && this.files[0]) {
                        label.textContent = '📄 ' + this.files[0].name;
                    } else {
                        label.textContent = '📁 Выберите файл';
                    }
                });
            }

            // Валидация чисел
            const numberInputs = document.querySelectorAll('input[type="number"]');
            numberInputs.forEach(input => {
                input.addEventListener('change', function() {
                    if (this.value < 0) this.value = 0;
                    if (this.value > 10 && this.id && this.id.includes('manaCost')) {
                        this.value = 10;
                    }
                });
            });
        });
    </script>
{% endblock %}